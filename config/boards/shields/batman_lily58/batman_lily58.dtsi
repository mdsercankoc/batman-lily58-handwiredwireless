#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    // 58 Tuşlu Lily58 Geometrisi (Her yanda 4x6 ana blok + 5 başparmak tuşu)
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>; // 6 sol + 6 sağ
        rows = <5>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                        RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)    RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // SuperMini nRF52840 Kesin GPIO Adreslemeleri
        row-gpios
            = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // 006
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // 008
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 017
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 020
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // 022
            ;

        col-gpios
            = <&gpio0 24 GPIO_ACTIVE_HIGH> // 024
            , <&gpio1 0 GPIO_ACTIVE_HIGH>  // 100 (Port 1, Pin 0)
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // 011
            , <&gpio1 4 GPIO_ACTIVE_HIGH>  // 104 (Port 1, Pin 4)
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // 031
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // 029
            ;
    };
};
