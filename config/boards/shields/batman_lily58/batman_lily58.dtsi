#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &batman_layout;
    };

    // --- ZMK STUDIO GÖRSEL MATRİS VE KOORDİNAT HARİTASI ---
    physical_layouts {
        compatible = "zmk,physical-layouts";
        batman_layout: batman_layout {
            compatible = "zmk,physical-layout";
            display-name = "Batman Lily58 Wireless";
            transform = <&default_transform>;
            kscan = <&kscan0>;
            keys = <
                // Satır 0
                &k00 &k01 &k02 &k03 &k04 &k05    &k06 &k07 &k08 &k09 &k10 &k11
                // Satır 1
                &k12 &k13 &k14 &k15 &k16 &k17    &k18 &k19 &k20 &k21 &k22 &k23
                // Satır 2
                &k24 &k25 &k26 &k27 &k28 &k29    &k30 &k31 &k32 &k33 &k34 &k35
                // Satır 3
                &k36 &k37 &k38 &k39 &k40 &k41    &k42 &k43 &k44 &k45 &k46 &k47
                // Satır 4 (Başparmaklar)
                          &k48 &k49 &k50 &k51 &k52    &k53 &k54 &k55 &k56 &k57
            >;
        };
    };

    // --- 58 TUŞUN FİZİKSEL X/Y KOORDİNATLARI (CHROME ARAYÜZÜ İÇİN ZORUNLU) ---
    // Sol Yarı (X: 0 - 500 arası) | Sağ Yarı (X: 700 - 1200 arası) | Standart 1U Tuş = 100x100
    
    // Satır 0 (Y: 0)
    k00: k00 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <0>; y = <0>; };
    k01: k01 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <100>; y = <0>; };
    k02: k02 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <200>; y = <0>; };
    k03: k03 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <300>; y = <0>; };
    k04: k04 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <400>; y = <0>; };
    k05: k05 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <500>; y = <0>; };
    k06: k06 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <700>; y = <0>; };
    k07: k07 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <800>; y = <0>; };
    k08: k08 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <900>; y = <0>; };
    k09: k09 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1000>; y = <0>; };
    k10: k10 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1100>; y = <0>; };
    k11: k11 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1200>; y = <0>; };

    // Satır 1 (Y: 100)
    k12: k12 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <0>; y = <100>; };
    k13: k13 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <100>; y = <100>; };
    k14: k14 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <200>; y = <100>; };
    k15: k15 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <300>; y = <100>; };
    k16: k16 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <400>; y = <100>; };
    k17: k17 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <500>; y = <100>; };
    k18: k18 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <700>; y = <100>; };
    k19: k19 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <800>; y = <100>; };
    k20: k20 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <900>; y = <100>; };
    k21: k21 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1000>; y = <100>; };
    k22: k22 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1100>; y = <100>; };
    k23: k23 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1200>; y = <100>; };

    // Satır 2 (Y: 200)
    k24: k24 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <0>; y = <200>; };
    k25: k25 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <100>; y = <200>; };
    k26: k26 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <200>; y = <200>; };
    k27: k27 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <300>; y = <200>; };
    k28: k28 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <400>; y = <200>; };
    k29: k29 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <500>; y = <200>; };
    k30: k30 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <700>; y = <200>; };
    k31: k31 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <800>; y = <200>; };
    k32: k32 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <900>; y = <200>; };
    k33: k33 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1000>; y = <200>; };
    k34: k34 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1100>; y = <200>; };
    k35: k35 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1200>; y = <200>; };

    // Satır 3 (Y: 300)
    k36: k36 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <0>; y = <300>; };
    k37: k37 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <100>; y = <300>; };
    k38: k38 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <200>; y = <300>; };
    k39: k39 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <300>; y = <300>; };
    k40: k40 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <400>; y = <300>; };
    k41: k41 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <500>; y = <300>; };
    k42: k42 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <700>; y = <300>; };
    k43: k43 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <800>; y = <300>; };
    k44: k44 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <900>; y = <300>; };
    k45: k45 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1000>; y = <300>; };
    k46: k46 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1100>; y = <300>; };
    k47: k47 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1200>; y = <300>; };

    // Satır 4 (Başparmaklar - Y: 400)
    k48: k48 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <200>; y = <400>; };
    k49: k49 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <300>; y = <400>; };
    k50: k50 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <400>; y = <400>; };
    k51: k51 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <500>; y = <400>; };
    k52: k52 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <600>; y = <400>; };
    
    k53: k53 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <700>; y = <400>; };
    k54: k54 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <800>; y = <400>; };
    k55: k55 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <900>; y = <400>; };
    k56: k56 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1000>; y = <400>; };
    k57: k57 { compatible = "zmk,key-physical-attrs"; width = <100>; height = <100>; x = <1100>; y = <400>; };

    // --- 58 TUŞLU HAND-WIRED ELEKTRONİK MATRİS (DONANIM HARİTASI) ---
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>; // 6 Sol + 6 Sağ
        rows = <5>;
        
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)    RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row"; 

        row-gpios
            = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R0
            , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R1
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R2
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R3
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // R4
            ;

        col-gpios
            = <&gpio0 24 GPIO_ACTIVE_HIGH> // C0
            , <&gpio1 0 GPIO_ACTIVE_HIGH>  // C1
            , <&gpio0 11 GPIO_ACTIVE_HIGH> // C2
            , <&gpio1 4 GPIO_ACTIVE_HIGH>  // C3
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // C4
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // C5
            ;
    };
};
